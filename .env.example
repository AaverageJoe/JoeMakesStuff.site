# Copy this file to .env and fill in real values before running the server.

# Admin login for /admin. Only used the very first time the server starts
# (when no admin account exists yet in the database) — after that, change
# your password from within the admin panel instead of editing this file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Port the Express server (API + production frontend) listens on.
PORT=4000

# Your real domain, no trailing slash — used to build canonical URLs, Open
# Graph/Twitter image URLs, and the sitemap. Update this once the domain is
# actually pointed at this server, otherwise search engines and social share
# previews will reference the wrong URL.
SITE_URL=https://www.joemakesstuff.co.uk

# Optional: fixes the session-signing secret instead of auto-generating one
# on first run. Only needed if you want sessions to survive you deleting
# server/data/session-secret.txt.
# SESSION_SECRET=
