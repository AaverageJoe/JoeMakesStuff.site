# Copy this file to .env and fill in real values before running the server.

# Admin login for /admin. Only used the very first time the server starts
# (when no admin account exists yet in the database) — after that, change
# your password from within the admin panel instead of editing this file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Port the Express server (API + production frontend) listens on.
PORT=4000

# Your real domain, no trailing slash — used to build canonical URLs, Open
# Graph/Twitter image URLs, and the sitemap. Update this once the domain is
# actually pointed at this server, otherwise search engines and social share
# previews will reference the wrong URL.
SITE_URL=https://www.joemakesstuff.co.uk

# Optional: fixes the session-signing secret instead of auto-generating one
# on first run. Only needed if you want sessions to survive you deleting
# server/data/session-secret.txt.
# SESSION_SECRET=

# Crowd Sourcing Ideas thermal printer. Defaults to the USB device the
# Gprinter GP-58 enumerates as, mounted upside down so printing is flipped
# 180° by default — set to "false" if it's ever remounted the right way up.
# PRINTER_DEVICE=/dev/usb/lp0
# PRINTER_UPSIDE_DOWN=true

# Contact form: sends a notification email (via Resend, resend.com) for
# every submission. Sign up, grab an API key from the dashboard, paste it
# below. Without this set, submissions are still saved and visible on
# /dashboard — they just won't trigger an email.
# RESEND_API_KEY=
# Where notification emails get sent.
# CONTACT_TO_EMAIL=joe@makesstuff.uk
# Who they're sent from. The default below is Resend's own shared sandbox
# address, which works without verifying a domain first. Once a sending
# domain is verified on the Resend account, switch this to an address on
# it (e.g. notifications@joemakesstuff.uk) for better deliverability.
# CONTACT_FROM_EMAIL=onboarding@resend.dev
