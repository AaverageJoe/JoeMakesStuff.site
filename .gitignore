# Backend runtime data — never commit secrets or the database (which holds
# the admin password hash and session secret). server/uploads/ is tracked
# via Git LFS instead (see .gitattributes) — that's a deliberate, temporary
# choice for testing Pi deployments; see README for the caveats.
.env
server/data/

# One-off local backup made before the Aug 2026 image-optimization pass —
# not real site content, just a safety copy; too large for git regardless.
server/uploads_backup_preoptimization/

